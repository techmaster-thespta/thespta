<header class="thes__header">
  <div class="thes__header-wrap">
    <button type="button" class="thes__menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="thes-header-nav">
      <span></span><span></span><span></span>
    </button>
    <a class="thes__header-brand" href="{{page_urls.home}}">{{header_title}}</a>
    <nav class="thes__header-nav" id="thes-header-nav" aria-label="Primary">
      <ul>
{{NAV_ITEMS}}
      </ul>
    </nav>
  </div>
</header>
<script>
(function () {
  var menuBtn = document.querySelector(".thes__menu-btn");
  var nav = document.getElementById("thes-header-nav");
  if (menuBtn && nav) {
    menuBtn.addEventListener("click", function () {
      var open = nav.style.display !== "block";
      nav.style.display = open ? "block" : "";
      menuBtn.setAttribute("aria-expanded", String(open));
    });
  }
  var carets = document.querySelectorAll(".thes__nav-caret");
  for (var i = 0; i < carets.length; i++) {
    (function (btn) {
      var submenu = document.getElementById(btn.getAttribute("aria-controls"));
      if (!submenu) return;
      btn.addEventListener("click", function () {
        var open = submenu.style.display !== "block";
        submenu.style.display = open ? "block" : "none";
        btn.setAttribute("aria-expanded", String(open));
      });
    })(carets[i]);
  }
})();
</script>
