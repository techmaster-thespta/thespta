<!--
  TEMPLATE: tokens.html.tmpl
  Rendered from config/theme.json by build.py. Do not hand-edit the output
  in /pages — edit config/theme.json (colors/fonts) or this file (structure),
  then re-run `python3 build.py`.

  Everything is scoped under the "thes" class so it never clashes with
  Google Sites' own styles. No header/nav/footer chrome assumptions here
  beyond the footer we build ourselves (Google Sites has no native one).
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{google_fonts_url}}" rel="stylesheet">

<style>
  .thes {
    --navy: {{colors.navy}};
    --blue: {{colors.blue}};
    --yellow: {{colors.yellow}};
    --yellow-text: {{colors.yellow_text}};
    --teal: {{colors.teal}};
    --teal-tint: {{colors.teal_tint}};
    --coral: {{colors.coral}};
    --coral-tint: {{colors.coral_tint}};
    --bg-tint: {{colors.bg_tint}};
    --text: {{colors.text}};
    --text-muted: {{colors.text_muted}};
    --border: {{colors.border}};

    color: var(--text);
    font-family: '{{font_body}}', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    width: 100%;
    overflow-x: hidden;
  }
  .thes, .thes *, .thes *::before, .thes *::after { box-sizing: border-box; }
  .thes img { max-width: 100%; display: block; }
  .thes a { color: inherit; }
  .thes h1, .thes h2, .thes h3 { font-family: '{{font_display}}', Arial, sans-serif; font-weight: 700; margin: 0; color: var(--navy); }
  .thes__wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
  .thes__section { padding: 44px 0; }
  .thes__section--tint { background: var(--bg-tint); }
  .thes__section-head { max-width: 620px; margin: 0 auto 28px; text-align: center; }
  .thes__section-head h2 { font-size: clamp(1.35rem, 4vw, 1.8rem); }
  .thes__section-head p { color: var(--text-muted); margin: 8px 0 0; }
  .thes__eyebrow { display: inline-block; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); }

  /* ---- Page header (About / Get Involved / Events) ---- */
  .thes__pagehead-media { position: relative; width: 100%; max-width: 1200px; margin: 0 auto; line-height: 0; }
  .thes__pagehead-media img { width: 100%; height: auto; display: block; }
  .thes__pagehead-fade { position: absolute; top: 0; left: 0; right: 0; height: 40%; background: linear-gradient(to bottom, #ffffff 0%, rgba(255,255,255,0.85) 25%, rgba(255,255,255,0) 100%); pointer-events: none; }
  .thes__pagehead-text { max-width: 700px; margin: 0 auto; text-align: center; padding: 28px 20px 8px; }
  .thes__pagehead-text .thes__eyebrow { color: var(--blue); }
  .thes__pagehead-text h1 { font-size: clamp(1.6rem, 5vw, 2.1rem); margin-top: 6px; }
  .thes__pagehead-text p { color: var(--text-muted); margin: 10px auto 0; max-width: 56ch; }

  /* ---- Buttons ---- */
  .thes__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 12px 22px;
    border-radius: 999px; font-family: '{{font_display}}', sans-serif; font-weight: 700;
    font-size: 0.88rem; text-decoration: none; white-space: nowrap; border: 2px solid transparent;
  }
  .thes__btn--yellow { background: var(--yellow); color: var(--navy); }
  .thes__btn--navy { background: var(--navy); color: #fff; }
  .thes__btn--outline { background: transparent; border-color: var(--navy); color: var(--navy); }

  /* ---- Icon badges ---- */
  .thes__icon-circle {
    width: 46px; height: 46px; min-width: 46px; border-radius: 999px; display: flex;
    align-items: center; justify-content: center; color: #fff; background: var(--blue);
  }
  .thes__icon-circle--teal { background: var(--teal); }
  .thes__icon-circle--yellow { background: var(--yellow); color: var(--navy); }
  .thes__icon-circle--coral { background: var(--coral); }
  .thes__icon-circle--navy { background: var(--navy); }

  /* ---- Generic card grid (reused: quick actions, ways to help, impact) ---- */
  .thes__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .thes__grid--narrow { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  .thes__card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 20px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .thes__card h3 { font-size: 0.94rem; margin-top: 4px; }
  .thes__card p { margin: 0; color: var(--text-muted); font-size: 0.9rem; }
  .thes__card a { margin-top: 4px; font-weight: 700; font-size: 0.86rem; text-decoration: none; }
  .thes__card--teal a { color: var(--teal); }
  .thes__card--yellow a { color: var(--yellow-text); }
  .thes__card--coral a { color: var(--coral); }
  .thes__card--navy a { color: var(--navy); }

  /* ---- Icon-only item (impact grid, no card box) ---- */
  .thes__icon-item { display: grid; justify-items: center; gap: 8px; text-align: center; min-width: 0; }
  .thes__icon-item h3 { font-size: 0.94rem; }
  .thes__icon-item p { margin: 0; color: var(--text-muted); font-size: 0.86rem; }

  /* ---- Numbered steps ---- */
  .thes__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; counter-reset: thes-step; }
  .thes__step { position: relative; background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 20px; min-width: 0; }
  .thes__step::before {
    counter-increment: thes-step; content: counter(thes-step); display: flex; align-items: center;
    justify-content: center; width: 28px; height: 28px; border-radius: 999px; background: var(--navy);
    color: #fff; font-family: '{{font_display}}', sans-serif; font-weight: 700; font-size: 0.85rem; margin-bottom: 10px;
  }
  .thes__step h3 { font-size: 0.94rem; margin-bottom: 4px; }
  .thes__step p { margin: 0; color: var(--text-muted); font-size: 0.88rem; }

  /* ---- Events ---- */
  .thes__events-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
  .thes__featured-event { background: var(--navy); color: #fff; border-radius: 14px; padding: 26px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .thes__featured-event .thes__eyebrow { color: var(--yellow); }
  .thes__featured-event h3 { color: #fff; font-size: 1.2rem; }
  .thes__featured-event p { margin: 0; color: rgba(255,255,255,0.85); font-size: 0.92rem; }
  .thes__event-when { font-weight: 700; color: var(--yellow); font-size: 0.9rem; }
  .thes__featured-event a { margin-top: 6px; font-weight: 700; color: var(--yellow); text-decoration: none; }
  .thes__more-events { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 18px; display: grid; gap: 4px; align-content: start; min-width: 0; }
  .thes__more-events-row { display: flex; justify-content: space-between; gap: 10px; padding: 10px 4px; border-bottom: 1px solid var(--border); }
  .thes__more-events-row:last-child { border-bottom: none; }
  .thes__more-events-row strong { font-size: 0.92rem; }
  .thes__more-events-row span { color: var(--text-muted); font-size: 0.84rem; }
  .thes__more-events > a { margin-top: 8px; font-weight: 700; font-size: 0.86rem; color: var(--blue); text-decoration: none; }

  .thes__event-list { display: grid; gap: 10px; }
  .thes__event-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; }
  .thes__event-date { background: var(--navy); color: #fff; border-radius: 8px; text-align: center; padding: 5px 9px; line-height: 1.1; flex-shrink: 0; min-width: 50px; }
  .thes__event-date .thes__day { display: block; font-size: 1.05rem; font-weight: 800; }
  .thes__event-date .thes__month { display: block; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.85; }
  .thes__event-row-body { flex: 1; min-width: 140px; }
  .thes__event-row-body strong { font-size: 0.94rem; display: block; }
  .thes__event-row-body span { color: var(--text-muted); font-size: 0.84rem; }

  /* ---- Join / CTA band ---- */
  .thes__join { background: var(--bg-tint); border-radius: 16px; padding: 32px 24px; text-align: center; display: grid; gap: 14px; justify-items: center; }
  .thes__join h2 { font-size: clamp(1.2rem, 4vw, 1.6rem); max-width: 42ch; }
  .thes__join p { margin: 0; color: var(--text-muted); max-width: 48ch; }

  /* ---- Info card / board ---- */
  .thes__info-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 24px; display: grid; gap: 14px; align-content: start; }
  .thes__info-row { display: grid; gap: 2px; }
  .thes__info-row span:first-child { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
  .thes__info-row a { text-decoration: none; font-weight: 600; overflow-wrap: anywhere; }
  .thes__board { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
  .thes__board-member { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 14px; min-width: 0; }
  .thes__board-role { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--blue); }
  .thes__board-name { font-weight: 700; margin-top: 4px; }
  .thes__board-email { display: block; margin-top: 4px; font-size: 0.82rem; color: var(--text-muted); text-decoration: none; overflow-wrap: anywhere; }

  .thes__checklist { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .thes__checklist li { display: flex; gap: 10px; align-items: flex-start; }
  .thes__checklist svg { flex-shrink: 0; margin-top: 3px; color: var(--blue); }

  .thes__two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px; align-items: start; }

  /* ---- Calendar embed (Events page) ---- */
  .thes__cal-frame { position: relative; padding-bottom: 75%; height: 0; overflow: hidden; max-width: 100%; border-radius: 14px; border: 1px solid var(--border); }
  .thes__cal-frame iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
  @media (max-width: 600px) { .thes__cal-frame { padding-bottom: 120%; } }
  .thes__cal-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }

  /* ---- Footer (Google Sites has none of its own) ---- */
  .thes__footer { background: var(--navy); color: rgba(255,255,255,0.85); border-radius: 16px; }
  .thes__footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; padding: 32px 24px; }
  .thes__footer h4 { color: rgba(255,255,255,0.55); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 12px; }
  .thes__footer-brand { color: #fff; font-family: '{{font_display}}', sans-serif; font-weight: 700; font-size: 1.05rem; margin-bottom: 6px; }
  .thes__footer p, .thes__footer a { font-size: 0.88rem; color: rgba(255,255,255,0.8); text-decoration: none; margin: 0; }
  .thes__footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .thes__footer a:hover { text-decoration: underline; }
  .thes__footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); text-align: center; padding: 14px; font-size: 0.78rem; color: rgba(255,255,255,0.6); }
</style>
