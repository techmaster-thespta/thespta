<!--
  THUNDER HILL PTA — EVENT PAGE (generated by build.py — do not hand-edit
  pages/events/*.html)
  One shared template for every opt-in event page listed in
  config/event-pages.json — each entry there becomes
  pages/events/<slug>.html. Only events the PTA explicitly wants
  searchable get one; everything else stays calendar-only.
-->
{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead">
    <div class="thes__pagehead-text">
      <nav class="thes__breadcrumb" aria-label="Breadcrumb"><a href="{{page_urls.events}}">Events</a><span aria-hidden="true"> / </span><span>{{EVENT_TITLE}}</span></nav>
      <span class="thes__eyebrow">{{EVENT_EYEBROW}}</span>
      <h1>{{PAGE_TITLE}}</h1>
      <p>{{EVENT_TAGLINE}}</p>
    </div>
    <div class="thes__pagehead-media">
      <img src="{{PAGE_HEADER_IMAGE_URL}}" alt="{{school_name}}">
    </div>
  </div>

  <section class="thes__section">
    <div class="thes__wrap thes__two-col">
      <div class="thes__info-card">
        <div class="thes__info-row"><span>When</span><span>{{EVENT_WHEN}}</span></div>
        <div class="thes__info-row"><span>Where</span><span>{{EVENT_LOCATION}}</span></div>
        <div class="thes__info-row"><span>Questions?</span><span>{{EVENT_CONTACT}}</span></div>
        <div class="thes__cal-actions" style="margin-top:4px;">
          {{EVENT_ACTIONS}}
        </div>
      </div>
      <div>
{{EVENT_ABOUT}}
      </div>
    </div>
  </section>

  <section class="thes__section thes__section--tint">
    <div class="thes__wrap thes__two-col">
{{EVENT_SECTIONS}}
    </div>
  </section>

{{EVENT_FLYER}}

{{FOOTER}}

</div>
