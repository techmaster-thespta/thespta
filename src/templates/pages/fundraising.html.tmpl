{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead">
    <div class="thes__pagehead-text">
      <span class="thes__eyebrow">Support the PTA</span>
      <h1>{{PAGE_TITLE}}</h1>
      <p>Every one of these funds the programs, grants, and events {{org_name}} runs all year — pick whichever fits your family, or do all of them.</p>
    </div>
    <div class="thes__pagehead-media">
      <img src="{{PAGE_HEADER_IMAGE_URL}}" alt="{{school_name}}">
    </div>
  </div>

{{FUNDRAISING_SECTIONS}}

<section class="thes__section thes__section--tint">
  <div class="thes__wrap">
    <div class="thes__join">
      <h2>Own a Local Business?</h2>
      <p>Become a {{org_name}} sponsor — reach hundreds of local families, increase your visibility, and help fund the programs and events that support our students.</p>
      <a class="thes__btn thes__btn--navy" href="{{page_urls.become_sponsor}}">Become a Sponsor &rarr;</a>
    </div>
  </div>
</section>

{{FOOTER}}

</div>
