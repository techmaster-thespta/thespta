<!--
  THUNDER HILL PTA — BECOME A SPONSOR (generated by build.py — do not
  hand-edit pages/become-a-sponsor.html)
  Sponsorship tier/benefit/contact info lives in config/sponsorship.json.
  The list of businesses that have already joined lives on the separate
  Our Sponsors page (config/sponsors.json) — kept apart so "how
  sponsorship works" and "who's already sponsoring us" can each be
  linked to on their own.
-->
{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead">
    <div class="thes__pagehead-text">
      {{BREADCRUMB}}
      <span class="thes__eyebrow">Support Our School</span>
      <h1>{{PAGE_TITLE}}</h1>
      <p>Support {{school_short_name}}, invest in our community, and make a lasting impact.</p>
    </div>
    <div class="thes__pagehead-media">
      <img src="{{PAGE_HEADER_IMAGE_URL}}" alt="{{school_name}}">
    </div>
  </div>

{{SPONSORSHIP_SECTION}}

<section class="thes__section thes__section--tint">
  <div class="thes__wrap">
    <div class="thes__join">
      <h2>Curious Who's Already On Board?</h2>
      <p>See the local businesses already sponsoring {{school_short_name}}.</p>
      <a class="thes__btn thes__btn--navy" href="{{page_urls.sponsors}}">See Our Sponsors &rarr;</a>
    </div>
  </div>
</section>

{{FOOTER}}

</div>
