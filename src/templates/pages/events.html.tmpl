<!--
  THUNDER HILL PTA — EVENTS (generated by build.py — do not hand-edit pages/events.html)
  Google Sites: paste into the Events page's Insert > Embed > Embed code block.
  Calendar URLs are built from config/site.json's "calendar" block — edit the
  calendar_id/timezone there, not here, then re-run python3 build.py.
-->
{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead">
    <div class="thes__pagehead-text">
      <span class="thes__eyebrow">What's Next</span>
      <h1>Upcoming Events</h1>
      <p>Everyone is welcome at every event — you don't need to be a PTA member to attend.</p>
    </div>
    <div class="thes__pagehead-media">
      <img src="{{PAGE_HEADER_IMAGE_URL}}" alt="{{school_name}}">
    </div>
  </div>

{{EVENTS_LIST_SECTION}}

  <!-- ===== Live calendar ===== -->
  <section class="thes__section thes__section--tint">
    <div class="thes__wrap">
      <div class="thes__section-head">
        <h2>Full Calendar</h2>
        <p>Always up to date — this pulls directly from the PTA's shared Google Calendar.</p>
      </div>

      <div class="thes__cal-frame">
        <iframe
          src="{{CAL_EMBED_SRC}}"
          scrolling="no"
          title="{{org_name}} Calendar"></iframe>
      </div>

      <p style="margin:20px 0 8px; color:var(--text-muted); font-size:0.92rem;">Add these events to your own calendar:</p>
      <div class="thes__cal-actions">
        <a class="thes__btn thes__btn--navy" href="{{CAL_WEBCAL_URL}}">Subscribe (Apple / Outlook)</a>
        <a class="thes__btn thes__btn--navy" href="{{CAL_GOOGLE_ADD_URL}}" target="_blank" rel="noopener">Add to Google Calendar</a>
        <a class="thes__btn thes__btn--outline" href="{{CAL_ICS_URL}}" download="thes-pta-calendar.ics">Download .ics</a>
      </div>

      <div class="thes__info-card" style="margin-top:20px;">
        <h4 style="margin:0 0 4px; color:var(--text-muted); font-size:0.74rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase;">Syncing on an iPhone or iPad</h4>
        <p style="margin:0; color:var(--text-muted); font-size:0.9rem;">
          Tapping <strong>Subscribe (Apple / Outlook)</strong> should open the Calendar app directly and offer to add the PTA calendar automatically. If it doesn't:
        </p>
        <ol style="margin:8px 0 0; padding-left:18px; color:var(--text-muted); font-size:0.9rem; display:grid; gap:4px;">
          <li>Open <strong>Settings &rarr; Calendar &rarr; Accounts &rarr; Add Account &rarr; Other</strong>.</li>
          <li>Tap <strong>Add Subscribed Calendar</strong>.</li>
          <li>Paste this URL: <span style="overflow-wrap:anywhere;">{{CAL_WEBCAL_URL}}</span></li>
        </ol>
        <p style="margin:8px 0 0; color:var(--text-muted); font-size:0.9rem;">Once subscribed this way, new events the PTA adds show up automatically — no need to re-import.</p>
      </div>
    </div>
  </section>

{{FOOTER}}

</div>
